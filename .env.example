# Browser-safe public configuration only.
# These values are embedded into the Vite client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# NEVER add service-role keys, database passwords, or other privileged secrets
# to VITE_* variables. Privileged deployment credentials belong in the hosting
# provider / CI secret store and are not read by the browser application.
